{
  "compatibility_date": "2026-06-15",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "name": "knowledge",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 検索インデックスへのアクセスにも認証を必須とするため、Worker (middleware) を経由させる
    "run_worker_first": ["/pagefind/*"],
  },
  "observability": {
    "enabled": true,
  },
}
