---
import { getCollection } from "astro:content";

import Layout from "../../layouts/Layout.astro";

const categories = await getCollection("categories");

const topLevelCategories = categories.filter((category) => !category.data.id.includes("/"));
---

<Layout class="container m-auto px-6 md:w-[80%]" title="カテゴリー一覧">
  <h1>カテゴリー一覧</h1>
  <ul>
    {topLevelCategories.map((category) => {
      return (
        <li>
          <a href={`/categories/${category.data.id}`}>{category.data.categoryName}</a>
        </li>
      );
    })}
  </ul>
</Layout>
