---
import { getCollection } from "astro:content";

import Layout from "../../layouts/Layout.astro";

const metaDatas = await getCollection("metaData");

interface CategoryEntry {
  path: String;
  categoryName: String;
}

const entries: Array<CategoryEntry> = [];

metaDatas.map((metaData) => {
  entries.push({
    path: metaData.id.split("/").slice(0, -1).join("/"),
    categoryName: metaData.data.categoryName,
  });
});
---

<Layout class="container m-auto px-6 md:w-[80%]" title="カテゴリー一覧">
  <h1>カテゴリー一覧</h1>
  <ul>
    {
      entries.map((entry) => {
        return (
          <li>
            <a href={`/docs/${entry.path}`}>{entry.categoryName}</a>
          </li>
        );
      })
    }
  </ul>
</Layout>
