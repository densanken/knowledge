---
// ------------------------------------
// 目次用のファイル
// ------------------------------------
import { getCollection } from "astro:content";

import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const metaDatas = await getCollection("metaData");
  const docs = await getCollection("docs");

  // 重複の無いカテゴリ名を抽出
  return metaDatas.map((metaData) => {
    const dirPath = metaData.id.split("/").slice(0, -1).join("/");
    const extractedDocs = docs.filter((doc) => doc.id.startsWith(dirPath));
    return {
      params: { slug: dirPath },
      props: { category: metaData.data.categoryName, docs: extractedDocs },
    };
  });
}

const { category, docs } = Astro.props;

export const prerender = true;
---

<Layout class="container m-auto px-6 md:w-[80%]" title={category}>
  <h1>{category} ドキュメント一覧</h1>
  <ul>
    {
      docs.map((doc) => {
        return (
          <li>
            <a href={`/docs/${doc.id}`}>
              {doc.data.title}
              {doc.data.description && <p>{doc.data.description}</p>}
            </a>
          </li>
        );
      })
    }
  </ul>
</Layout>
