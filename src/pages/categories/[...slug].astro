---
// ------------------------------------
// 目次用のファイル
// ------------------------------------
import { getEntry } from "astro:content";
import { getCategorySummary } from "../../lib/internal-docs-catgory-summary";

import Layout from "../../layouts/Layout.astro";
import CategoryIndex from "./_components/CategoryIndex.astro";

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404 });
}

const category = await getEntry("categories", slug);

if (!category) {
  return new Response(null, { status: 404 });
}

const categorySummary = await getCategorySummary(category);
---

<Layout class="container m-auto px-6 md:w-[80%]" title={categorySummary.categoryName}>
  <CategoryIndex categorySummary={categorySummary} level={1} />
</Layout>
